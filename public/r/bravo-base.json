{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "bravo-base",
  "title": "Bravo Base",
  "description": "Foundation for Bravo sites: theme tokens, base styles and utils.",
  "dependencies": [
    "class-variance-authority",
    "lucide-react",
    "tw-animate-css"
  ],
  "registryDependencies": [
    "@bravo/utils",
    "@bravo/bravo-theme"
  ],
  "files": [],
  "cssVars": {
    "theme": {
      "font-sans": "ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'",
      "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
    },
    "light": {
      "background": "var(--bg-section-base)",
      "foreground": "var(--text-primary)",
      "card": "var(--bg-content-base)",
      "card-foreground": "var(--text-primary)",
      "popover": "var(--bg-content-base)",
      "popover-foreground": "var(--text-primary)",
      "primary": "var(--bg-content-brand)",
      "primary-foreground": "var(--text-primary-inverse)",
      "secondary": "var(--bg-content-subtle)",
      "secondary-foreground": "var(--text-primary)",
      "muted": "var(--bg-content-subtle)",
      "muted-foreground": "var(--text-muted)",
      "accent": "var(--bg-content-subtle)",
      "accent-foreground": "var(--text-primary)",
      "destructive": "var(--bg-content-destructive)",
      "border": "var(--border-light)",
      "input": "var(--border-dark)",
      "ring": "var(--border-brand-focus)"
    }
  },
  "css": {
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground": {}
      }
    }
  },
  "type": "registry:style"
}